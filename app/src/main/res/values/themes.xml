<resources>
    <style name="Base.Theme.EcospherePickup" parent="Theme.Material3.DayNight.NoActionBar">
    </style>

    <style name="Theme.EcospherePickup" parent="Base.Theme.EcospherePickup" />

    <style name="EcosphereProgressStep">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/bg_progress_step</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/eco_secondary_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="EcosphereProgressLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/eco_secondary_text</item>
        <item name="android:textSize">10sp</item>
    </style>
</resources>
